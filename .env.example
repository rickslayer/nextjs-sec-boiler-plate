# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file with real secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------
# JWT Authentication
# Generate with: openssl rand -base64 48
# -----------------------------------------------------------------------
JWT_SECRET=replace-with-min-32-char-random-string
JWT_EXPIRATION=7d

# -----------------------------------------------------------------------
# Session
# Generate with: openssl rand -base64 48
# -----------------------------------------------------------------------
SESSION_SECRET=replace-with-different-min-32-char-random-string

# -----------------------------------------------------------------------
# Rate Limiter
# RATE_LIMIT_WINDOW_MS   — sliding window in milliseconds (default: 60000 = 1 min)
# RATE_LIMIT_MAX_REQUESTS — max requests per window per identifier (default: 100)
# RATE_LIMIT_IDENTIFIER  — what to use as key: "ip" | "header" (default: ip)
#                          "header" reads x-forwarded-for / x-real-ip
# Note: the in-memory store works for single-process deployments.
#       Set RATE_LIMIT_STORE=redis and REDIS_URL for multi-instance.
# -----------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_IDENTIFIER=ip

# -----------------------------------------------------------------------
# Allowed Origins (CORS)
# Comma-separated list of allowed origins.
# Leave empty to allow all origins (not recommended for production).
# -----------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# -----------------------------------------------------------------------
# Required Headers (for /api/* routes)
# Comma-separated list. Format: "header-name" or "header-name:expected-value"
# Example: REQUIRED_HEADERS=x-api-key,x-client-version:1.0
# Leave empty to require no extra headers.
# -----------------------------------------------------------------------
REQUIRED_HEADERS=

# -----------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
