{
  "name": "nextjs-sec-boiler-plate",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm audit --audit-level=critical && node scripts/check-secrets.mjs",
    "build": "next build",
    "build:ci": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check-secrets": "node scripts/check-secrets.mjs",
    "audit:critical": "npm audit --audit-level=critical",
    "audit:json": "npm audit --json"
  },
  "dependencies": {
    "jose": "^5.9.6",
    "next": "^16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
